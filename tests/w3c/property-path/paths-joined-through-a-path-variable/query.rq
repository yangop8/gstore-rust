# spec: SPARQL 1.1 Query §18.5 Join and §18.4: a path whose end point another pattern of the
# group binds joins with that pattern's solutions (review sparqlconf#9);
# every node ?m between :n1 and :n5 is a separate solution
PREFIX : <http://example.org/>
SELECT ?a ?b { ?a :id 1 . ?b :id 5 . ?a :next* ?m . ?m :next* ?b }
