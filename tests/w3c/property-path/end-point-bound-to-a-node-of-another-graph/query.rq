# spec: SPARQL 1.1 Query §13.3 (GRAPH: the named graph is the active graph), §18.4
# (ZeroOrMorePath with two variables: t in nodes(G)) and §18.5 Join: inside GRAPH :g the
# zero-length matches are the nodes of :g, so :a, a node of the default graph only,
# matches nothing there
PREFIX : <http://example.org/>
SELECT ?s ?x { GRAPH :g { VALUES ?s { :a :c } ?s :next* ?x } }
