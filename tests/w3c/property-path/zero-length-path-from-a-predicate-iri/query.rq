# spec: SPARQL 1.1 Query §9.4 and §18.4 (ZeroLengthPath, ALP): a constant end point matches
# itself at length zero whether or not it occurs in the data;
# :knows occurs only as a predicate, which is no node of the graph (review sparqlconf#13)
PREFIX : <http://example.org/>
SELECT ?x { :knows :knows* ?x }
