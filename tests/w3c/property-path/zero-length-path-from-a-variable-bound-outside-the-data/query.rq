# spec: SPARQL 1.1 Query §18.4 (ZeroOrMorePath with two variables: t in nodes(G)) and §18.5
# Join: a variable end point bound by another pattern joins with the path's own solutions,
# whose zero-length matches are the nodes of the graph only
PREFIX : <http://example.org/>
SELECT ?s ?x { VALUES ?s { :a :zzz } ?s :knows* ?x }
