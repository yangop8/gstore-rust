# spec: SPARQL 1.1 Query §17.4.2.11 STRLANG (simple literal lexicalForm, simple literal
# langTag): STRLANG("chat", "en") is "chat"@en; a lexical form that already carries a tag is
# an error, not a retagging (review sparqlconf#17)
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (STRLANG("chat", "en") AS ?a) (STRLANG("chat"^^xsd:string, "fr") AS ?b)
       (STRLANG("chat"@fr, "en") AS ?c) (STRLANG("chat", "en"@en) AS ?d) (STRLANG(1, "en") AS ?e)
WHERE {}
