# spec: SPARQL 1.1 Query §12 Subqueries, §13.3 GRAPH and §19.8 Grammar rule [53] GroupGraphPattern ::= '{' ( SubSelect | GroupGraphPatternSub ) '}': GRAPH ?g { SELECT … }
# The sub-query runs once per named graph, against that graph.
PREFIX : <http://example.org/>
SELECT ?g ?total
WHERE { GRAPH ?g { SELECT (SUM(?v) AS ?total) WHERE { ?s :v ?v } } }
