# spec: SPARQL 1.1 Query §12 Subqueries and §19.8 Grammar rule [53] GroupGraphPattern ::= '{' ( SubSelect | GroupGraphPatternSub ) '}': the WHERE group is the sub-query
PREFIX : <http://people.example/>
SELECT ?y ?minName
WHERE {
  SELECT ?y (MIN(?name) AS ?minName)
  WHERE { ?y :name ?name . }
  GROUP BY ?y
}
