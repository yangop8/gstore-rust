# spec: SPARQL 1.1 Query §12 Subqueries, §8.2 MINUS and §19.8 Grammar rule [53] GroupGraphPattern ::= '{' ( SubSelect | GroupGraphPatternSub ) '}': MINUS { SELECT … }
# alice and bob know carol and are removed.
PREFIX : <http://example.org/>
SELECT ?p
WHERE {
  ?p :age ?a
  MINUS { SELECT ?p WHERE { ?p :knows :carol } }
}
