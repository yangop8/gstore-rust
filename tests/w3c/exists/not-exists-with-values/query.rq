# spec: SPARQL 1.1 Query §8.1.1 Testing For the Absence of a Pattern and §18.6 (the pattern is
# evaluated under the current solution): VALUES ?s { :a } has a solution compatible with ?s = :a
# only, so the :x rows pass
PREFIX : <http://example.org/>
SELECT ?s WHERE { ?s :p ?o FILTER NOT EXISTS { VALUES ?s { :a } } }
