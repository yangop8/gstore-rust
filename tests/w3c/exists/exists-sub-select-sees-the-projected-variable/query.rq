# spec: SPARQL 1.1 Query §12 Subqueries and §18.6: the sub-select projects ?s, which must be
# compatible with the current solution; only :x has more than one :p
PREFIX : <http://example.org/>
SELECT ?s WHERE { ?s :p ?o
  FILTER EXISTS { { SELECT ?s WHERE { ?s :p ?z } GROUP BY ?s HAVING (COUNT(*) > 1) } } }
