# spec: SPARQL 1.1 Query §9.1 Property Path Syntax and §18.2.2.3 / §18.4 (Negated Property Set):
# the forward branch finds :d :likes :a, the inverse branch the same triple read
# backwards (review sparqlconf#3)
PREFIX : <http://example.org/>
SELECT ?x ?y { ?x !(:knows|:name|:age|^:knows|^:name|^:age) ?y }
