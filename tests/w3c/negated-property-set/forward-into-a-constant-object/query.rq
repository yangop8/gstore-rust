# spec: SPARQL 1.1 Query §9.1 Property Path Syntax and §18.2.2.3 / §18.4 (Negated Property Set):
# ?x !:knows :a is one step into :a over any predicate but :knows; the step
# walked backwards from the constant object still excludes :knows (review query#2)
PREFIX : <http://example.org/>
SELECT ?x { ?x !:knows :a }
