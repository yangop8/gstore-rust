# spec: SPARQL 1.1 Query §9.1 Property Path Syntax and §18.2.2.3 / §18.4 (Negated Property Set):
# !(:knows|^:knows) is alt(NPS({:knows}), inv(NPS({:knows}))): one step out of :a
# or one step into :a, over any predicate but :knows (review sparqlconf#3)
PREFIX : <http://example.org/>
SELECT ?x { :a !(:knows|^:knows) ?x }
