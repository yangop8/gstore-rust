# spec: SPARQL 1.1 Query §17.4.3.14 REGEX with XPath fn:matches §5.6.1.1: a flag other than
# s, m, i, x, q is an error (FORX0001), so the FILTER (§17.2: an error is not true) keeps
# no solution and the SELECT expression (§18.2.4.1 Extend) leaves ?r unbound
PREFIX : <http://example.org/>
SELECT ?x ?r WHERE {
  { ?x :name ?n FILTER(REGEX(?n, "^A", "u")) }
  UNION
  { BIND(REGEX("Alice", "^A", "iu") AS ?r) }
}
