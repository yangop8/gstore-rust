# gStore diagnostic log configuration (log4cplus properties) -- example
# shipped with gstore-rust, mirroring upstream gStore's conf/slog.properties.
#
# conf.ini's [log] log_mode names the file gserver reads (default
# ./conf/slog.properties); copy this file there to log to ./logs/all.log as
# well as to the console. gstore-rust honours the subset upstream's files use:
#   log4cplus.rootLogger=LEVEL, APPENDER...   (TRACE DEBUG INFO WARN ERROR FATAL OFF)
#   log4cplus.appender.X=log4cplus::ConsoleAppender           -> standard error
#   log4cplus.appender.X=log4cplus::DailyRollingFileAppender  -> the log file
#     .File            the active log file; it is rolled into <File>.YYYY-MM-DD
#     .MaxBackupIndex  accepted; as in log4cplus (where it limits one day's
#                      .1, .2 ... backups) no daily file is ever deleted
#     .MaxHistory      days of rolled files kept (default: all, as upstream;
#                      conf.ini's log_days sets it too)
#     .Schedule        DAILY (the only schedule supported)
#     .Threshold       the most verbose level this appender records
# Layouts and filters are accepted and ignored: every record is written as
#   YYYY-MM-DD HH:MM:SS.mmm [LEVEL] [module] message

# TRACE DEBUG INFO WARN ERROR FATAL
log4cplus.rootLogger=INFO, ALL_MSGS, STDOUT

log4cplus.appender.STDOUT=log4cplus::ConsoleAppender
log4cplus.appender.STDOUT.layout=log4cplus::PatternLayout
log4cplus.appender.STDOUT.layout.ConversionPattern=%D{%Y-%m-%d %H:%M:%S.%q} -%m%n

log4cplus.appender.ALL_MSGS=log4cplus::DailyRollingFileAppender
log4cplus.appender.ALL_MSGS.File=./logs/all.log
log4cplus.appender.ALL_MSGS.MaxBackupIndex=30
# MONTHLY, WEEKLY, DAILY, TWICE_DAILY, HOURLY, MINUTELY
log4cplus.appender.ALL_MSGS.Schedule=DAILY
log4cplus.appender.ALL_MSGS.Append=true
log4cplus.appender.ALL_MSGS.layout=log4cplus::PatternLayout
log4cplus.appender.ALL_MSGS.layout.ConversionPattern=%D{%Y-%m-%d %H:%M:%S.%q} [%5t] [%5p] [%22.30b:%-4L]-%m%n
log4cplus.appender.ALL_MSGS.filters.1=log4cplus::spi::LogLevelRangeFilter
log4cplus.appender.ALL_MSGS.filters.1.LogLevelMin=TRACE
log4cplus.appender.ALL_MSGS.filters.1.LogLevelMax=FATAL
log4cplus.appender.ALL_MSGS.filters.1.AcceptOnMatch=true
log4cplus.appender.ALL_MSGS.filters.2=log4cplus::spi::DenyAllFilter
