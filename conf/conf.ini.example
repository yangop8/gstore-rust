# gStore server configuration (conf.ini) -- example shipped with gstore-rust.
#
# This mirrors upstream gStore 1.4's conf/conf.ini key for key and value for
# value. Copy it to conf/conf.ini (gserver reads ./conf/conf.ini when it exists)
# or pass it explicitly:  gserver -c conf/conf.ini
#
# Syntax: [section] headers, key=value lines; whitespace around keys and values
# is trimmed and double quotes are removed from values. Lines starting with '#'
# or ';' are comments, and so is the rest of an unquoted value after
# whitespace + '#' or ';'. An empty value (key=) means "use the built-in
# default". If a key appears twice, the first one wins. Unknown keys are
# reported as warnings and ignored.
#
# Precedence: command-line flag (e.g. -p/--port, --password, --no-checkpoint,
# --addr, or a database directory argument) > this file > built-in default.
# Relative paths are relative to the directory gserver is started from.

[server]
# the http api port
port=9000
# the socket api port (upstream's socket API is not built in 1.4; parsed only)
tcp_port=9100
# worker threads serving HTTP requests
thread_num=30
max_database_num=100
max_user_num=1000
# use deamon thread to run the server, values: on or off
# (on: a supervisor process restarts gserver if it crashes; spelled "deamon"
# as upstream, "daemon" is accepted too)
deamon=off
# the maximum output result, default 100000
# max_output_size=100000
# (gstore-rust) how long one SPARQL statement may run, in seconds (fractions
# allowed); a statement still running then is stopped and answered as timed
# out (REST 503, /api 1005), releasing its database. 0 = no limit
# (default 3600)
# query_timeout=3600
# (gstore-rust) the most bytes one serialized query answer may take; a larger
# one is answered "result too large" (page with LIMIT/OFFSET instead).
# 0 = no limit (default 1073741824, 1 GiB)
# max_result_bytes=1073741824
# ip_allow_path first if both path are configured
ip_allow_path=
ip_deny_path="./conf/ipDeny.config"
# (gstore-rust) failed logins are counted per account and address (an IPv6
# client by its /64 network): after more than login_lockout_failures failures
# (the next failure locks; default: the 5th, as upstream's errornum > 4) that
# account is locked for that address, first for 1 s, each further failure
# doubling the lock up to login_lockout_max_seconds; a lock refuses only that
# account's password checks (no password hash runs), and a success clears only
# its own count. More than 8 x login_lockout_failures failures of any accounts
# from one address lock that address too, except for accounts that logged in
# from it successfully within the last hour. refreshconf applies these keys.
# Turning upstream_login_lockout on restores upstream's rule instead (an
# address with more than 4 failures is refused everything but login and
# testConnect until a successful login or a restart): unlimited guessing
# through login, and behind a proxy one client locks out all. Upstream-compat
# switch, default off.
;upstream_login_lockout=off
# login_lockout_failures=4
# login_lockout_max_seconds=900

# ---- gstore-rust extensions (not in upstream conf.ini) ----
# address the HTTP listener binds; upstream listens on every interface,
# set 0.0.0.0 to do the same (default 127.0.0.1)
# listen_addr=127.0.0.1
# keep-alive idle timeout in seconds, 0 turns keep-alive off (default 60)
# keep_alive_timeout=60
# minimum average rate, in bytes per second, at which a request body must
# arrive after a 30 s grace: T seconds after the request head, at least
# (T - 30) * min_body_rate bytes of the body must be in (what was really
# received counts, not the declared Content-Length), so a client trickling it
# in cannot hold a worker thread. A chunked body's framing (chunk extensions,
# trailers) counts against the body cap too. The same floor applies to a
# client reading a file download: after write_timeout's grace (30 s) it must
# take the response at this rate on average, or the connection is closed (a
# slow reader cannot hold a download slot). 0 turns both limits off (default
# 65536, 64 KiB/s)
# min_body_rate=65536
# most connections one client IP address may have open at once, those
# waiting for a worker thread included; further ones are closed at once.
# Clients behind one NAT or proxy share an address: raise it for them;
# 0 = no limit (default 64)
# max_conns_per_ip=64
# maximum requests served on one connection (default 100)
# keep_alive_max=100
# accepted connections that may wait for a free worker thread before the
# server stops accepting more (default 128)
# queue_size=128
# CORS processing: answer OPTIONS preflight requests and send
# Access-Control-Allow-Origin -- to the origins of cors_allow_origin only --
# values: on or off (default on)
# cors=on
#
# Browser-facing secure defaults. Each commented line below shows the
# default; setting one of these switches restores an upstream behaviour, and
# gserver then logs a startup warning "upstream-compat: <key>=<value>".
#
# origins (scheme://host[:port], separated by '|' or ',') whose web pages may
# call this server from a browser: they get Access-Control-Allow-Origin, their
# preflights are answered and their state-changing requests accepted. Empty
# (the default): no foreign origin. '*' is upstream's
# Access-Control-Allow-Origin: * -- any web page could then read the answers
# and send writes through a visitor's browser.
;cors_allow_origin=
# host names a request arriving over loopback may name in its Host header,
# besides IP addresses, localhost and names without a dot (a guard against
# DNS rebinding: a web page whose own name is re-resolved to 127.0.0.1 is
# refused). List the public name a reverse proxy passes on, if it passes the
# client's Host. '*' turns the check off. Default: none. A web page served
# through a proxy that rewrites Host to this server's address (nginx's
# default proxy_pass) sends its public Origin, which then matches no Host:
# list that origin in cors_allow_origin, or let the proxy keep the client's
# Host (nginx: proxy_set_header Host $host;) and list the name here.
;allowed_hosts=
# on: GET /sparql may run a SPARQL UPDATE and /update takes a body of any type
# (text/plain included), as upstream; a web page can then change the data
# with a mere <img> or form. off (the default): an update is POSTed to
# /update as application/sparql-update or a form (SPARQL 1.1 Protocol).
;allow_get_update=off
# on: a loopback peer forwarding Forwarded / X-Forwarded-For / X-Real-IP
# counts as a local client, as upstream. off (the default): it is a reverse
# proxy speaking for remote clients, so it gets none of the privileges of a
# local client (the unauthenticated single-database mode, root's default
# password, the /api layer's trust_inner_localhost). This works only for a
# proxy that sends one of those headers: one that adds none (nginx without
# proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; HAProxy
# without option forwardfor; stunnel, ssh or socat tunnels) cannot be told
# apart from a local client. Never put the unauthenticated single-database
# mode or allow_default_root_password=on behind such a proxy.
;trust_proxy_headers=off
# on: gserver starts the API server although root still has the default
# password "123456" -- on a loopback address only, and the password is then
# accepted from local clients only. off (the default): refused on every
# address. Set root's password instead (--password-file, root_password below
# for a new user store); to change an existing store's, start once with this
# switch on 127.0.0.1, change it (gconsole setpswd, /api userPassword), then
# remove the switch.
;allow_default_root_password=off

[system]
# unit MB
min_memory=1024
min_million_disk=200
min_million_memory=200
resource_check=off
# the directory do you want to place your database in
# NOTICE:the position is ideally in the root of system directory
# (gserver also keeps its pid file, gserver.pid, and the log of a background
# start, gserver.log, in this directory)
# db_home="./dbhome/"

# which suffix do you want to add to your database name? please set it here
# NOTICE:all database name ends with ".db" by default, but you shouldn't add ".db" to the name you pass to system
# db_suffix=".db"

# root username
root_username="root"
# root default password (used when the user store is first created; gserver
# refuses to serve the API while root still has 123456 -- set your own, or see
# allow_default_root_password in [server])
root_password="123456"
# system username for shutdown (its password is generated at every start and
# written to the second line of the pid file)
system_username="system"
# auto check point, default on
check_point=on
# seconds after which an open transaction with no statement running is
# rolled back (logged as ABORTED), so a client that vanishes after begin
# cannot block its database's writes and maintenance; also frees a RocksDB
# database's copy for it. A transaction of a deleted user is rolled back too.
# 0 = never (upstream behaviour; gserver warns at startup) (Rust extension)
txn_idle_timeout=600
# build use multi thread increase efficiency
build_multi_thread=off
# gbuild --disk builds the indexes in bulk (sorted, bottom-up). Its sort
# buffers stay within this many MiB, spilling sorted runs to disk beyond it;
# the dictionary under construction (about 26 bytes plus the term per term)
# comes on top (Rust extension)
# build_memory_mb=1024
# threads of that bulk build, 0 = every core; build_multi_thread=off means 1
# (Rust extension)
# build_threads=0
# where it spills sorted runs (default: inside the database directory)
# (Rust extension)
# build_tmp_dir="/tmp"
# how full it packs B+ tree nodes, 50-100 percent; the slack takes later
# inserts without splitting nodes (Rust extension)
# build_fill_factor=90
# free the ids of terms a delete leaves unused (no triple or quad refers to
# them any more) so new terms reuse them, lowest first: on (default) or off
# (ids are only freed by gcompact --reclaim). A kvstore.kv written before
# Phase 6 keeps reclamation off until gcompact --enable-reclaim, which makes
# the file unreadable for older binaries; new on-disk databases are created
# with it unless this is off. gserver and gbuild read it; the other
# command-line tools (gadd, gsub, gquery, ...) follow GSTORE_ID_RECLAIM only.
# GSTORE_ID_RECLAIM=on|off overrides it (Rust extension)
# id_reclaim=on
# the license type login / testConnect / getCoreVersion report: an upstream
# key upstream's default conf.ini leaves out (default "opensource")
# licensetype="opensource"
# where PFN user functions (funcudb / funquery / funreview) are stored: an
# upstream key upstream's default conf.ini leaves out (upstream default
# "./pfn/"; gstore-rust's: <db_home>/pfn). Read when gserver starts:
# refreshconf does not move the functions. They belong to users, not to
# databases, so no database backup holds them: back up this directory
# (docs/DEPLOY.md, "Backups"). See [pfn] below and docs/PFN.md.
# pfn_base_path="./pfn/"
[log]
# choose the system core log output model
# config/slog.stdout.properties for console
# config/slog.properties for file
log_mode="./conf/slog.properties"
# save the query log
# 0: not save
# 1: save the log
# (gstore-rust: a relative querylog_path / accesslog_path is taken relative to
# db_home, not to the working directory; the plain-text <db_home>/query.log
# and access.log follow the *_mode switches too and roll over daily, keeping
# *_days days)
querylog_mode=1
querylog_path="logs/endpoint/"
querylog_days=30
# you can choose whether to record the operation log, by default it is opened.
# If it is closed(that is, the option is uncommented and set to 0), then system will run fatser but maybe not safe and recoverable
accesslog_mode=1
accesslog_path="logs/ipaccess/"
accesslog_days=30

# ---- gstore-rust extensions (not in upstream conf.ini) ----
# The diagnostic log (gserver's errors, warnings and lifecycle events) is
# configured like upstream's: log_mode names a log4cplus properties file (see
# conf/slog.properties.example: root level, a console appender and a
# DailyRollingFileAppender with File, which keeps every rolled file as
# upstream's log4cplus does); when that file does
# not exist the log goes to standard error at level info. These keys override
# the properties file; the GSTORE_LOG environment variable (a level) overrides
# log_level. /api refreshconf re-reads log_mode's file and these keys and
# reconfigures the log, as upstream's refreshconf re-runs log4cplus (the
# querylog_* / accesslog_* keys above take effect at once too).
# level: trace, debug, info, warn, error or off
# log_level=info
# log file, rolled daily into <file>.YYYY-MM-DD; off for none
# log_file=logs/all.log
# days of rolled log files to keep, 0 keeps them all (default: all with a
# properties file, as upstream; 30 when log_file sets the file)
# log_days=30
# also write the log to standard error, values: on or off (default on)
# log_stderr=on

[backup]
# backup database path. The HTTP API's /backup and /restore only write and read
# backups inside it (when this key is not set: <db_home>/backups).
backup_path="./backups/"
# max backups file, if the number of backup files more than the value, system will remove the old backup files.
max_backups=3

[upload]
upload_path = "./upload/"
# max body size, 256 MB = 262144 KB(1M=1024KB) = 268435456 B(1KB=1024B)
# (upstream ships 1 GB = 1073741824). gstore-rust caps every HTTP request body
# at this size, and lets a request carry this much only when it is
# authenticated before its body is read: an upstream upload (/file/upload, an
# /api query) whose credentials are in the URL query string (username=,
# password=; an Authorization header does not count there), or a REST upload
# (/upload, /update, /build, /tquery, /batchInsert, /batchRemove) with HTTP
# Basic or a session token (Authorization: Bearer, X-Session-Token, or
# session= / token= in the URL; username= / password= do not count there).
# refreshconf applies a new value to the upload operation; the HTTP caps
# below need a restart.
upload_max_body_size = 268435456
# (gstore-rust extension) the largest body a request may have before it is
# authenticated, on every route (64 MB; at most upload_max_body_size). An
# upstream client sends its credentials inside the body (an /api JSON body,
# the /file/upload form), so this is also the most it can upload: set it to
# upload_max_body_size to restore upstream's limit.
preauth_max_body_size = 67108864
# (gstore-rust extension) the request-body bytes all connections may hold in
# memory at once (512 MB; at least upload_max_body_size): a request that would
# exceed it is answered 503 (retry later).
request_body_budget = 536870912
# allow extensions (also of build / batchInsert / batchRemove sources; with
# the `gzip` feature `x.nt.gz` counts as `nt`). gstore-rust adds the quad
# formats to upstream's "nt|ttl|n3|rdf|txt": export writes N-Quads (.nq) for
# a database with named graphs, and must be able to build it again.
upload_allow_extensions = "nt|ttl|n3|rdf|txt|nq|trig"
# allow compress package
upload_allow_compress_packages = "zip"
# (gstore-rust extension, feature `zip`) limits a zip package must stay within
# to be unpacked by build / batchInsert / batchRemove / restore: its number of
# entries, and the bytes its files unpack to in all (zip-bomb guard).
unzip_max_entries = 10000
unzip_max_size = 10737418240
# (gstore-rust extension) /file/download. By default a download needs a valid
# username / password, and a user reads a file only with the matching
# privilege on the database it came from (export / query) or when he uploaded
# it. Upstream serves the export directory (exports, format=file results) to
# anyone; the upstream-compat switch below restores that (a risk: anyone who
# guesses a file name reads it; gserver warns at startup while it is on).
;anonymous_download=off
# downloads streamed at once (more are answered 503); 0 = no limit
download_max_concurrent = 8
# hours after which uploads, exports and format=file results the server wrote
# are removed (files an operator put there are kept); 0 = keep them forever
file_retention_hours = 168
# bytes of uploads each user may keep (an upload beyond is refused); 0 = no quota
upload_user_quota = 0

# ---- gstore-rust extension (not in upstream conf.ini) ----
# How every database the server serves evaluates queries. gserver applies
# these to each database it loads, builds, creates or restores (and re-applies
# them to the loaded ones on /api refreshconf). Upstream has no keys for
# them: its query cache budget (100 MB) is a constant and its integer division
# always truncates. The values shown are the defaults.
[query]
# how '/' divides two integers: decimal (SPARQL 1.1: 7/2 = 3.5) or truncate
# (upstream gStore: 7/2 = 3, AVG over integers truncates too)
# integer_division=decimal
# per-database read-query cache budget in bytes (0 turns the cache off);
# results of deterministic read queries are cached until the data changes
# query_cache_size=67108864
# stop LIMIT (no ORDER BY), ASK and EXISTS evaluations as soon as enough
# solutions are found
# early_termination=on
# answer ORDER BY ... LIMIT with a bounded heap instead of a full sort
# topk_bounded_heap=on
# DP-B Top-K for ORDER BY <linear expression> LIMIT over a tree-shaped BGP:
# auto (when the statistics predict it pays off), always or off
# topk_dpb=auto
# the most bytes of JSON the graph-function calls (shortestPaths, kHopEnumerate,
# PR, ...) of one query may produce together -- every call, GROUP BY group and
# GRAPH block of the query counts -- before the query fails with an error
# (default 64 MiB; an embedded Database allows 256 MiB)
# gfun_max_output_bytes=67108864

# ---- gstore-rust extension (not in upstream conf.ini) ----
# Sandbox limits of PFN user functions (funcudb / funquery / funreview, and
# SELECT (PFN.name({...}) AS ?v) in queries). gstore-rust runs PFN functions as
# WebAssembly in an interpreter (cargo feature pfn-wasm) instead of compiling
# C++ with g++ and dlopen()ing it like upstream; see docs/PFN.md. They live
# under [system]'s pfn_base_path (upstream's key; when it is not set:
# <db_home>/pfn). The output of the calls of one query is bounded by [query]'s
# gfun_max_output_bytes. Like [query], these apply to every database the
# server serves and /api refreshconf re-applies them (to the loaded databases
# and to the function registry). The values shown are the defaults.
[pfn]
# the most WebAssembly instructions one function call may run (0 = unlimited;
# a call is also stopped when its query is cancelled)
# pfn_fuel_per_call=1000000000
# the most 64 KiB pages a function's memory may grow to (1024 = 64 MiB)
# pfn_max_memory_pages=1024
# the largest function module, source text and compiled binary, in bytes
# pfn_max_module_bytes=1048576
# the most functions one user may own
# pfn_max_functions=100

# ---- gstore-rust extension (not in upstream conf.ini) ----
# How databases are opened. gserver installs these as the defaults when it
# starts and again on /api refreshconf (databases loaded from then on use
# them; loaded ones keep the mode they were opened in); the environment
# overrides them (GSTORE_DISK_QUERY_MODE=stream|memory,
# GSTORE_DISK_CACHE_MB). Every mode reads and writes the same files: a
# directory may be opened in either mode, and by older binaries, in turn.
# The values shown are the defaults (default_layout is unset by default).
[storage]
# how an on-disk (kvstore.kv, gbuild --disk) database answers queries:
# memory = load its dictionary and triples into memory when it is opened
# (fast queries, memory and open time grow with the data); stream = read the
# B+ trees and the dictionary from disk on demand (opens in well under a
# second whatever the size, memory bounded by the caches below)
# disk_query_mode=memory
# MiB of page cache per on-disk database
# disk_cache_mb=16
# MiB a stream-mode database's dictionary may cache (four fifths id -> term,
# one fifth term -> id)
# dict_cache_mb=80
# build the VS-tree index when a database is opened without a fresh one
# (RocksDB databases, which persist none; a stream-mode database whose
# vstree.kv was made stale by updates) instead of querying without it until
# it is rebuilt. Off: opening stays fast; the first queries may be slower
# vstree_on_open=off
# the layout a build that names none creates (snapshot, disk or rocksdb;
# unset = snapshot): REST /build and /api build (their layout parameter
# overrides it) and gbuild (--layout, --disk, --rocksdb override it). A new
# disk database keeps a free-id list (id_reclaim above) unless id_reclaim=off
# default_layout=disk
# MiB of the block cache a RocksDB database shares across its column
# families, 0 = RocksDB's own default (32 MiB per column family);
# GSTORE_ROCKS_BLOCK_CACHE_MB overrides it
# rocksdb_block_cache_mb=256
# bloom filters of RocksDB's point-lookup column families: bits per key,
# on (= 10) or off; options only, files open either way
# rocksdb_bloom=10
# the most files a RocksDB database keeps open (20..1048576; 0 = unlimited,
# RocksDB's own default: one descriptor per table file, kept while the
# database is open); options only, files open with any value
# rocksdb_max_open_files=4096

# Reasoning rules (/api reasonManage, stored per database in
# <db>.db/reason_rule_files/) have no conf.ini keys: their limits are fixed --
# at most 1000 rules per database, 1 MiB per rule file, 64 conditions per rule,
# 256 patterns and 64 filters per condition, 4 KiB per term and 16 KiB per
# filter, rule names of at most 128 characters (240 bytes). Executing a rule
# is an update like any other: it obeys check_point and empties the [query]
# cache.
