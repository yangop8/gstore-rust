#!/bin/sh
# postrm of the gstore .deb. The databases in /var/lib/gstore are kept, also
# on purge (delete them by hand); purge removes only the ./conf link and the
# first-start root password file.
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
if [ "$1" = "purge" ] && [ -L /var/lib/gstore/conf ]; then
    rm -f /var/lib/gstore/conf
fi
# The first-start root password file postinst created (not a conffile).
if [ "$1" = "purge" ]; then
    rm -f /etc/gstore/root_password
fi

exit 0
