#!/bin/sh
# postrm of the gstore .deb. The databases in /var/lib/gstore are kept, also
# on purge (delete them by hand); purge removes only the ./conf link and the
# first-start root password file.
set -e

# The unit's enablement survives a remove (review infra#15): its enable links
# stay, recorded by deb-systemd-helper, and the unit is masked while its file
# is gone; postinst unmasks it on the next install and enables it again if it
# was enabled. A purge forgets both (dh_installsystemd's protocol).
if command -v deb-systemd-helper >/dev/null 2>&1; then
    if [ "$1" = "remove" ]; then
        deb-systemd-helper mask gserver.service >/dev/null || true
    fi
    if [ "$1" = "purge" ]; then
        deb-systemd-helper purge gserver.service >/dev/null || true
        deb-systemd-helper unmask gserver.service >/dev/null || true
    fi
fi
if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null 2>&1 || true
fi
if [ "$1" = "purge" ]; then
    if [ -L "${DPKG_ROOT:-}/var/lib/gstore/conf" ]; then
        rm -f "${DPKG_ROOT:-}/var/lib/gstore/conf"
    fi
    # The first-start root password file postinst created (not a conffile).
    rm -f "${DPKG_ROOT:-}/etc/gstore/root_password"
fi

exit 0
