#!/bin/sh
# postrm of the gstore .deb. The databases in /var/lib/gstore are kept, also
# on purge (delete them by hand); purge removes only the ./conf link.
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
if [ "$1" = "purge" ] && [ -L /var/lib/gstore/conf ]; then
    rm -f /var/lib/gstore/conf
fi

exit 0
