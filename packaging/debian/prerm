#!/bin/sh
# prerm of the gstore .deb: stop the server (gracefully: SIGTERM saves unsaved
# changes) before its files are removed. Whether the unit is enabled is left
# as it is (review infra#15: `systemctl disable` here lost the
# administrator's choice across a remove and a later install); postrm masks
# the unit while its file is gone and postinst restores it.
set -e

if [ -z "${DPKG_ROOT:-}" ] && [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke stop gserver.service >/dev/null || true
    else
        systemctl stop gserver.service >/dev/null 2>&1 || true
    fi
fi

exit 0
