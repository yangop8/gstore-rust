# gNLQA configuration — copy this file to your per-user config directory and
# fill in your API key:
#
#   mkdir -p ~/.config/gnlqa
#   cp gnlqa.conf.example ~/.config/gnlqa/gnlqa.conf   &&   $EDITOR ~/.config/gnlqa/gnlqa.conf
#
# gNLQA reads $GNLQA_CONFIG if set, else $XDG_CONFIG_HOME/gnlqa/gnlqa.conf,
# else ~/.config/gnlqa/gnlqa.conf. It does NOT read a gnlqa.conf in the current
# directory (an untrusted checkout could ship one that redirects your keys);
# use GNLQA_CONFIG=./gnlqa.conf to opt in for a directory you trust. A
# world-writable file is refused. Real env vars still override the file. Keep
# the file private (chmod 600): it holds your key. See gnlqa/README.md.

# ---- LLM backend: DeepSeek (OpenAI-compatible) — the default ----
GNLQA_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
OPENAI_BASE_URL=https://api.deepseek.com
GNLQA_MODEL=deepseek-v4-pro
GNLQA_FAST_MODEL=deepseek-v4-flash
# deepseek-v4-pro is a reasoning model (slow); give calls plenty of time.
GNLQA_TIMEOUT_SECS=180

# ---- Alternative backend: Anthropic (Claude) ----
# GNLQA_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# GNLQA_MODEL=claude-opus-4-8
# GNLQA_FAST_MODEL=claude-sonnet-4-6

# ---- gStore SPARQL endpoint ----
GSTORE_ENDPOINT=http://127.0.0.1:9000/sparql
# GSTORE_USER=
# GSTORE_PASSWORD=

# ---- optional ----
# GNLQA_MODE=auto            # auto | structured | graphrag | open (applies to CLI, chat, serve, mcp)
# GNLQA_CACHE=256            # answer-cache capacity (0 disables)
# GNLQA_CACHE_TTL_SECS=3600  # cache entry lifetime in seconds (0 = no expiry)
# GNLQA_CACHE_MAX_BYTES=67108864  # answer-cache byte budget; answers above 1/8 of it are not cached
# GNLQA_MAX_TOKENS=1024      # minimum completion-token budget per request (raise for reasoning models)
# GNLQA_RETRIES=3            # retries of a transient LLM/gStore failure (429, 5xx) with back-off (0 = none)

# ---- gnlqa serve / mcp (HTTP authentication and per-request limits) ----
# `gnlqa serve` refuses to start without a client token; clients send
# `Authorization: Bearer <token>`. Generate one, e.g. `openssl rand -hex 24`.
# GNLQA_HTTP_TOKEN=
# Explicit opt-out: answer loopback clients only, without a token (default off).
# GNLQA_HTTP_ALLOW_UNAUTHENTICATED=off
# GNLQA_HTTP_RATE_PER_MIN=30      # /ask + /gSolve requests per client IP per minute (0 = unlimited)
# GNLQA_MAX_QUESTION_BYTES=4096   # longest accepted question (bytes)
# GNLQA_MAX_LLM_CALLS=16          # LLM calls per request / MCP tool call (0 = unlimited)
# GNLQA_MAX_KB_ROWS=200000        # KB rows per request / MCP tool call (0 = unlimited)
# GNLQA_REQUEST_TIMEOUT_SECS=120  # wall-clock budget per request / MCP tool call (0 = none)
